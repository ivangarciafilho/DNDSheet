{
  "name": "5e-monster-maker",
  "version": "2.4.3",
  "description": "A monster builder and generator for 5th Edition Dungeons and Dragons. Effortlessly create a monster with tools for automatically computing CR, formatting a statblock, and managing your monster actions and traits.",
  "productName": "Falindrith's D&D Monster Maker",
  "author": "Evan Shimizu <ebshimizu@gmail.com>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "npm run test:core",
    "test:core": "node --experimental-strip-types --test test/core/*.test.ts",
    "test:e2e": "node test/exhaustive-ui-fuzz.js",
    "test:e2e:spellcasting": "node test/spell-plate-browser-smoke.js",
    "test:e2e:help": "node test/statblock-help-browser-smoke.js",
    "gate": "node test/gate.mjs",
    "audit:help": "node test/audit-help.mjs",
    "dev": "npx quasar dev",
    "build": "npx quasar build",
    "build:pwa": "npx quasar build -m pwa",
    "typecheck": "node tools/typecheck.mjs",
    "typecheck:setup": "cd tools/typecheck-runtime && npm ci --ignore-scripts --no-audit --no-fund",
    "audit:fit": "node tools/qa/overflow-probe.js",
    "test:e2e:matrix": "node --experimental-strip-types test/release-matrix-browser-smoke.js"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "@vueuse/core": "^8.6.0",
    "@zumer/snapdom": "^2.0.1",
    "copy-to-clipboard": "^3.3.2",
    "core-js": "^3.6.5",
    "fs-extra": "^10.1.0",
    "json-url": "^3.0.0",
    "jsonschema": "^1.4.1",
    "lodash": "^4.17.21",
    "number-to-words": "^1.2.4",
    "pinia": "^2.0.11",
    "pinia-plugin-persistedstate": "^3.0.0",
    "quasar": "^2.16.11",
    "slugify": "^1.6.5",
    "url": "^0.11.0",
    "uuid": "^8.3.2",
    "vue": "^3.0.0",
    "vue-i18n": "^9.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^3.3.1",
    "@quasar/app-vite": "^1.9.5",
    "@quasar/cli": "^2.4.1",
    "@types/lodash": "^4.14.182",
    "@types/node": "^12.20.21",
    "@types/number-to-words": "^1.2.1",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "acorn": "8.15.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^8.5.0",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "prettier": "^2.5.1",
    "typescript": "^4.5.4",
    "workbox-build": "7.0.x",
    "workbox-cacheable-response": "7.0.x",
    "workbox-core": "7.0.x",
    "workbox-expiration": "7.0.x",
    "workbox-precaching": "7.0.x",
    "workbox-routing": "7.0.x",
    "workbox-strategies": "7.0.x"
  },
  "engines": {
    "node": "^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
